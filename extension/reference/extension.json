{
  "schemaVersion": 2,
  "id": "io.github.alexmaster23.surveycraft",
  "name": "SurveyCraft",
  "version": "0.4.1",
  "cadcraft": ">=0.7.0, <1.0.0",
  "description": "Open-source surveying tools for CADCraft.",
  "license": "MIT OR Apache-2.0",
  "runtime": {
    "kind": "wasm-component",
    "entrypoint": "surveycraft.wasm",
    "world": "cadcraft:extension/cadcraft-extension@0.1.0"
  },
  "commands": [
    {
      "id": "surveycraft.points.import",
      "label": "Import and insert points...",
      "menu": ["SurveyCraft", "Points", "Import and insert points..."],
      "aliases": ["SCPOINTS", "SCPIMPORT"],
      "params": "{convention:'cad-xy'|'survey-xy',rows:[{number,x,y,elevation,code?}],labelHeight?} -> {inserted,entities,totalPoints,projectId}",
      "function": "insert-points",
      "interactive": false,
      "ui": {
        "kind": "table",
        "title": "SurveyCraft — Import points",
        "description": "Choose the source coordinate convention, then type points or open a CSV, COO, TXT or XYZ file. Review the mapping and insert every valid row into the active drawing.",
        "submitLabel": "Insert points",
        "accent": "#F47A20",
        "selects": [
          {
            "key": "convention",
            "label": "Coordinate convention",
            "default": "cad-xy",
            "choices": [
              {
                "value": "cad-xy",
                "label": "CAD / GIS — X → CAD X, Y → CAD Y"
              },
              {
                "value": "survey-xy",
                "label": "Survey / TopoLT — X → CAD Y, Y → CAD X"
              }
            ]
          }
        ],
        "columns": [
          {
            "key": "number",
            "label": "Point number",
            "kind": "text",
            "required": true,
            "unique": true,
            "aliases": ["point", "name", "id", "nr", "numar", "număr"]
          },
          {
            "key": "x",
            "label": "Input X",
            "kind": "number",
            "required": true,
            "aliases": ["easting", "east", "e", "cad x", "cadx"]
          },
          {
            "key": "y",
            "label": "Input Y",
            "kind": "number",
            "required": true,
            "aliases": ["northing", "north", "n", "cad y", "cady"]
          },
          {
            "key": "elevation",
            "label": "Elevation (Z)",
            "kind": "number",
            "required": true,
            "aliases": ["elevation", "height", "z", "h", "cota", "cotă"]
          },
          {
            "key": "code",
            "label": "Code / description",
            "kind": "text",
            "aliases": ["code", "description", "desc", "cod"]
          }
        ]
      }
    },
    {
      "id": "surveycraft.points.manager",
      "label": "Point Manager...",
      "menu": ["SurveyCraft", "Points", "Point Manager..."],
      "aliases": ["SCPOINTMANAGER", "SCPM"],
      "params": "{action:'list'|'update'|'delete'|'synchronize'|'renumber'|'export',...} -> manager rows, mutation summary or CSV text",
      "function": "manage-points",
      "interactive": false,
      "ui": {
        "kind": "manager",
        "title": "SurveyCraft — Point Manager",
        "description": "Filter, select, locate and edit the persistent survey points in this drawing. Saving synchronizes point geometry and labels in one undo step.",
        "accent": "#F47A20",
        "idKey": "id",
        "entityIdsKey": "entities",
        "renumberKey": "number",
        "allowDelete": true,
        "allowExport": true,
        "columns": [
          {
            "key": "number",
            "label": "Point number",
            "kind": "text",
            "editable": true,
            "required": true,
            "unique": true,
            "width": 110
          },
          {
            "key": "x",
            "label": "CAD X / Easting",
            "kind": "number",
            "editable": true,
            "required": true,
            "width": 130
          },
          {
            "key": "y",
            "label": "CAD Y / Northing",
            "kind": "number",
            "editable": true,
            "required": true,
            "width": 130
          },
          {
            "key": "elevation",
            "label": "Elevation",
            "kind": "number",
            "editable": true,
            "required": true,
            "width": 110
          },
          {
            "key": "code",
            "label": "Code",
            "kind": "text",
            "editable": true,
            "width": 120
          },
          {
            "key": "description",
            "label": "Description",
            "kind": "text",
            "editable": true,
            "width": 180
          },
          {
            "key": "quality",
            "label": "Quality",
            "kind": "text",
            "width": 120
          },
          {
            "key": "status",
            "label": "Link status",
            "kind": "text",
            "width": 110
          }
        ]
      }
    },
    {
      "id": "surveycraft.points.check-links",
      "label": "Check point links",
      "menu": ["SurveyCraft", "Points", "Check point links"],
      "aliases": ["SCCHECKPOINTS"],
      "params": "{} -> {projectId,points,healthyPoints,missingEntities,modifiedEntities,orphanedEntities,issues}",
      "function": "inspect-project",
      "interactive": false
    },
    {
      "id": "surveycraft.coding.code-book",
      "label": "Code Book...",
      "menu": ["SurveyCraft", "Coding", "Code Book..."],
      "aliases": ["SCCODEBOOK", "SCCB"],
      "params": "{action:'list'|'preview'|'update'|'delete'|'export',...} -> native code-rule editor rows, diagnostics or JSON",
      "function": "manage-code-book",
      "interactive": false,
      "ui": {
        "kind": "manager",
        "title": "SurveyCraft — Code Book",
        "description": "Edit exact, prefix and regex rules; preview every unsaved rule against coded points before saving. Match mode: exact/prefix/regex. Graphic kind: none/line/symbol.",
        "accent": "#F47A20",
        "idKey": "record",
        "entityIdsKey": "entities",
        "allowDelete": true,
        "allowExport": true,
        "allowAdd": true,
        "allowEntityActions": false,
        "allowSynchronize": false,
        "allowPreview": true,
        "columns": [
          {
            "key": "rule-id",
            "label": "Rule ID",
            "kind": "text",
            "editable": true,
            "required": true,
            "unique": true,
            "width": 130
          },
          {
            "key": "pattern",
            "label": "Pattern",
            "kind": "text",
            "editable": true,
            "required": true,
            "width": 120
          },
          {
            "key": "match-mode",
            "label": "Match mode",
            "kind": "text",
            "editable": true,
            "required": true,
            "width": 100
          },
          {
            "key": "description",
            "label": "Description",
            "kind": "text",
            "editable": true,
            "required": true,
            "width": 180
          },
          {
            "key": "optimization-rank",
            "label": "Rank",
            "kind": "number",
            "editable": true,
            "required": true,
            "width": 70
          },
          {
            "key": "layer",
            "label": "Layer ID",
            "kind": "text",
            "editable": true,
            "width": 105
          },
          {
            "key": "graphic-kind",
            "label": "Graphic kind",
            "kind": "text",
            "editable": true,
            "required": true,
            "width": 105
          },
          {
            "key": "style-or-symbol",
            "label": "Style / symbol",
            "kind": "text",
            "editable": true,
            "width": 170
          },
          {
            "key": "scale-or-width",
            "label": "Scale / width",
            "kind": "number",
            "editable": true,
            "required": true,
            "width": 105
          },
          {
            "key": "attribute-from-suffix",
            "label": "Suffix attribute",
            "kind": "text",
            "editable": true,
            "width": 110
          },
          {
            "key": "status",
            "label": "Preview",
            "kind": "text",
            "width": 105
          }
        ]
      }
    },
    {
      "id": "surveycraft.coding.generate",
      "label": "Generate coded features",
      "menu": ["SurveyCraft", "Coding", "Generate coded features"],
      "aliases": ["SCGENERATE", "SCGEN"],
      "params": "{planScaleDenominator?:number,includeUnmarked?:boolean} -> generated feature and diagnostic counts",
      "function": "generate-coded-features",
      "interactive": false
    },
    {
      "id": "surveycraft.reference-line",
      "label": "Create diagnostic reference line",
      "menu": [],
      "params": "{} -> {entityId}",
      "function": "reference-line",
      "interactive": false
    }
  ],
  "toolsets": [
    {
      "tab": "drafting",
      "group": "SurveyCraft",
      "position": "top",
      "accent": "#F47A20",
      "tools": [
        {
          "command": "surveycraft.points.import",
          "icon": "import",
          "size": "large"
        },
        {
          "command": "surveycraft.points.manager",
          "icon": "table",
          "size": "large"
        },
        {
          "command": "surveycraft.points.check-links",
          "icon": "properties",
          "size": "small"
        },
        {
          "command": "surveycraft.coding.code-book",
          "icon": "settings",
          "size": "large"
        },
        {
          "command": "surveycraft.coding.generate",
          "icon": "polyline",
          "size": "large"
        }
      ]
    }
  ],
  "permissions": [
    "drawing-read",
    "drawing-write"
  ],
  "homepage": "https://github.com/AlexMaster23/surveycraft"
}
