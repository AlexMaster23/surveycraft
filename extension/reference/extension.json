{
  "schemaVersion": 2,
  "id": "io.github.alexmaster23.surveycraft",
  "name": "SurveyCraft",
  "version": "0.1.0",
  "cadcraft": ">=0.7.0, <1.0.0",
  "description": "Open-source surveying tools for CADCraft.",
  "license": "MIT OR Apache-2.0",
  "runtime": {
    "kind": "wasm-component",
    "entrypoint": "surveycraft.wasm",
    "world": "cadcraft:extension/cadcraft-extension@0.1.0"
  },
  "commands": [
    {
      "id": "surveycraft.points.import",
      "label": "Import and insert points...",
      "menu": ["SurveyCraft", "Points", "Import and insert points..."],
      "aliases": ["SCPOINTS", "SCPIMPORT"],
      "params": "{rows:[{number,northing,easting,elevation,code?}],labelHeight?} -> {inserted,entities}",
      "function": "insert-points",
      "interactive": false,
      "ui": {
        "kind": "table",
        "title": "SurveyCraft — Import points",
        "description": "Type survey points or open a CSV, COO, TXT or XYZ coordinate file. Review the table, then insert every valid row into the active drawing.",
        "submitLabel": "Insert points",
        "accent": "#F47A20",
        "columns": [
          {
            "key": "number",
            "label": "Point number",
            "kind": "text",
            "required": true,
            "unique": true,
            "aliases": ["point", "name", "id", "nr", "numar", "număr"]
          },
          {
            "key": "northing",
            "label": "Northing (Y)",
            "kind": "number",
            "required": true,
            "aliases": ["northing", "north", "n", "y"]
          },
          {
            "key": "easting",
            "label": "Easting (X)",
            "kind": "number",
            "required": true,
            "aliases": ["easting", "east", "e", "x"]
          },
          {
            "key": "elevation",
            "label": "Elevation (Z)",
            "kind": "number",
            "required": true,
            "aliases": ["elevation", "height", "z", "h", "cota", "cotă"]
          },
          {
            "key": "code",
            "label": "Code / description",
            "kind": "text",
            "aliases": ["code", "description", "desc", "cod"]
          }
        ]
      }
    },
    {
      "id": "surveycraft.reference-line",
      "label": "Create diagnostic reference line",
      "menu": [],
      "params": "{} -> {entityId}",
      "function": "reference-line",
      "interactive": false
    }
  ],
  "permissions": [
    "drawing-write"
  ],
  "homepage": "https://github.com/AlexMaster23/surveycraft"
}
